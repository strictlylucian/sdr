---
import { uiText } from '../i18n/messages';
const locale = Astro.currentLocale ?? 'ro';
---
<p class="sdr-doc-notice" data-pagefind-ignore>{uiText(locale, 'DocsNotice.disclaimer')}</p>
<style>
  .sdr-doc-notice { margin:0;color:var(--sl-color-gray-2);font-size:var(--sdr-text-sm);line-height:var(--sdr-leading);max-inline-size:var(--sdr-measure); }
</style>
