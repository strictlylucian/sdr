---
import { docsUrl } from '../docs-url';
import { studyText as t } from '../i18n/messages';
import { getFormStudy, type Locale, type StudyId } from '../studies/forms';
import StudyDemo from '../studies/StudyDemo';
interface Props { id: StudyId; locale: Locale; part: 'original' | 'proposal'; }
const { id, locale, part } = Astro.props;
const study = getFormStudy(id);
const date = new Intl.DateTimeFormat(locale === 'ro' ? 'ro-RO' : 'en-GB', { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(study.capturedOn));
---
{part === 'original' && <section aria-label={t(locale, 'original')}>
  <p><strong>{study.institution}</strong></p>
  <p>{t(locale, study.edition, { date })}</p>
  <figure class="sdr-form-source">
    <a href={study.source}><img src={docsUrl(`/studies/forms/${id}.webp`)} alt={`${t(locale, study.sourcePreview === 'publication' ? 'publishedServicePage' : 'original')}: ${t(locale, study.title)} — ${study.institution}`} width={study.image.width} height={study.image.height} loading="lazy" decoding="async" /></a>
    <figcaption>{t(locale, study.sourcePreview === 'publication' ? 'verifiedPublication' : study.sourceType === 'web' ? 'verifiedWeb' : 'verified', { date })} <a href={study.source}>{t(locale, study.sourcePreview === 'publication' ? 'openDocument' : study.sourceType === 'web' ? 'openWebsite' : 'openOriginal')}</a></figcaption>
  </figure>
</section>}
{part === 'proposal' && <section aria-label={t(locale, 'proposal')}>
  <p><a href={docsUrl(`/examples/${locale}/study-${id}.html`)}>{t(locale, 'openDemo')}</a></p>
  <div class="not-content sdr-form-study"><StudyDemo id={id} locale={locale} client:load /></div>
</section>}
<style>
  .sdr-form-source { display:grid;gap:var(--sdr-space-3);margin:var(--sdr-space-5) 0; }
  .sdr-form-source img { display:block;inline-size:100%;max-inline-size:32rem;block-size:auto;margin:0;border:var(--sdr-border-width) solid var(--sl-color-hairline); }
  .sdr-form-source figcaption { font-size:var(--sdr-text-sm);color:var(--sl-color-gray-2); }
</style>
