---
import eagle from '../identity/romanian-eagle.svg?raw';
const paths = eagle.slice(eagle.indexOf('>') + 1, eagle.lastIndexOf('</svg>'));
---
<svg class="sdr-identity-symbol" aria-hidden="true" width="0" height="0" focusable="false"><defs><g id="sdr-identity-eagle" fill="currentColor" fill-rule="evenodd" set:html={paths} /></defs></svg>
